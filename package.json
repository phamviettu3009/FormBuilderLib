{
  "name": "@local/form-builder",
  "version": "0.1.0",
  "private": true,
  "description": "UI-agnostic React schema-driven form builder with default validation rules.",
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": { "types": "./dist/types/index.d.ts", "import": "./dist/index.js" },
    "./rules": { "types": "./dist/types/rules.d.ts", "import": "./dist/rules.js" },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/build-styles.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run build && vitest run",
    "lint": "oxlint src tests scripts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "dependencies": { "fast-deep-equal": "^3.1.3" },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^27.0.0",
    "oxlint": "^1.88.0",
    "postcss": "^8.5.6",
    "postcss-selector-parser": "^7.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.0.0"
  }
}